#!/usr/bin/env bash

# Concise and Less Intrusive macOS Defaults Script

# Close any open System Preferences panes so changes can take effect immediately
osascript -e 'if application "System Preferences" is running then tell application "System Preferences" to quit' 2>/dev/null || true
osascript -e 'if application "System Settings" is running then tell application "System Settings" to quit' 2>/dev/null || true

# --- Essential Quality-of-Life UI Tweaks ---

# 1. Expand standard Save and Print panels by default
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

# 2. Automatically quit the printer app once print jobs complete
defaults write com.apple.print.PrintingPrefs "Quit When Finished" -bool true

# 3. Prioritize US English in AppleLanguages so CLI tools using GNU gettext
#    do not fall through "en-KR" into "ko-KR" (Korean)
defaults write NSGlobalDomain AppleLanguages -array "en-US" "en-KR" "ko-KR"

# 4. Enable faster keyboard repeat rates and disable press-and-hold in terminals
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 15

# --- Power Management (Prevent aggressive 1-minute sleep from dropping dev/agent streams) ---
# AC Power (-c): Never suspend CPU/network while plugged in; sleep display after 15 mins
# Battery (-b):  Sleep display after 10 mins; suspend system after 20 mins
if sudo -n true 2>/dev/null; then
    sudo pmset -c displaysleep 15 sleep 0
    sudo pmset -b displaysleep 10 sleep 20
else
    echo "Applying pmset power management settings (may prompt for sudo password)..."
    sudo pmset -c displaysleep 15 sleep 0
    sudo pmset -b displaysleep 10 sleep 20
fi

echo "macOS settings updated. Log out and log back in for all changes to take effect."
