    async def task_uv(self, t: TaskState) -> None:
        uv_path = shutil.which("uv") or ""
        real_uv = os.path.realpath(uv_path) if uv_path else ""
        if "Cellar/uv" not in real_uv and "homebrew" not in real_uv and not uv_path.startswith("/opt/homebrew/"):
            rc = await self.run_cmd(t, ["uv", "self", "update"], "uv self update", 0.0, 25.0, 2.0)
            if rc != 0:
                raise RuntimeError("uv self update failed")
        else:
            t.progress = 25.0

        rc = await self.run_cmd(t, ["uv", "python", "upgrade"], "uv python upgrade", 25.0, 35.0, 2.5)
        if rc != 0:
            raise RuntimeError("uv python upgrade failed")

        rc = await self.run_cmd(t, ["uv", "tool", "upgrade", "--all"], "uv tool upgrade --all", 60.0, 40.0, 2.5)
        if rc != 0:
            raise RuntimeError("uv tool upgrade failed")
        if not t.last_line:
            t.last_line = "Python & uv tools up to date"

    async def task_openclaw(self, t: TaskState) -> None:
        t.step_label = "Waiting for npm lock"
        async with self.npm_lock:
            rc = await self.run_cmd(t, ["openclaw", "update", "--yes"], "openclaw update --yes", 0.0, 100.0, 5.0)
            if rc != 0:
                raise RuntimeError("openclaw update failed")
        if not t.last_line:
            t.last_line = "OpenClaw up to date"

    async def task_npm(self, t: TaskState) -> None:
        npm_path = shutil.which("npm") or ""
        real_npm = os.path.realpath(npm_path) if npm_path else ""

        t.step_label = "Scanning global packages"
        proc = await asyncio.create_subprocess_exec(
            "npm", "list", "-g", "--depth=0", "--parseable",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        out, _ = await proc.communicate()
        lines = out.decode("utf-8", errors="replace").splitlines()[1:]
        pkgs = []
        for p in lines:
            if "/node_modules/" in p:
                pkg = p.split("/node_modules/")[-1].strip()
                if pkg and pkg not in ("npm", "openclaw"):
                    pkgs.append(pkg)

        t.progress = 25.0
        t.step_label = "Waiting for npm lock"
        async with self.npm_lock:
            if "Cellar/node" not in real_npm and "homebrew" not in real_npm:
                rc = await self.run_cmd(t, ["npm", "install", "-g", "npm"], "npm self-update", 25.0, 25.0, 3.0)
                if rc != 0:
                    raise RuntimeError("npm self-update failed")
            else:
                t.progress = 50.0

            if pkgs:
                rc = await self.run_cmd(
                    t,
                    ["npm", "update", "-g", *pkgs],
                    f"Updating {', '.join(pkgs)}",
                    50.0,
                    50.0,
                    4.0,
                )
                if rc != 0:
                    raise RuntimeError("npm update -g failed")
                t.last_line = f"Updated {', '.join(pkgs)}"
            else:
                t.progress = 100.0
                t.last_line = "No extra global packages to update"

    async def task_pip(self, t: TaskState) -> None:
        py_path = shutil.which("python3") or ""
        real_py = os.path.realpath(py_path) if py_path else ""
        if py_path == "/usr/bin/python3" or real_py.startswith("/Library/Developer/") or real_py.startswith("/System/"):
            await asyncio.sleep(0.15)
            t.progress = 100.0
            t.last_line = "System Python (managed via uv)"
            return

        check_code = (
            "import sysconfig, os\n"
            "for s in ('stdlib','platstdlib','purelib','platlib'):\n"
            "  p = sysconfig.get_path(s)\n"
            "  if p and os.path.exists(os.path.join(p, 'EXTERNALLY-MANAGED')): raise SystemExit(0)\n"
            "raise SystemExit(1)\n"
        )
        proc = await asyncio.create_subprocess_exec(
            "python3", "-c", check_code,
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL,
        )
        await proc.wait()
        if proc.returncode == 0:
            t.progress = 100.0
            t.last_line = "PEP 668 externally managed (skipped)"
            return

        rc = await self.run_cmd(t, ["python3", "-m", "pip", "install", "--upgrade", "pip"], "pip upgrade", 0.0, 100.0, 2.5)
        if rc != 0:
            raise RuntimeError("pip upgrade failed")

    async def task_neovim(self, t: TaskState) -> None:
        rc = await self.run_cmd(
            t,
            ["nvim", "--headless", "+Lazy! sync", "+qa"],
            "Lazy! sync",
            0.0,
            100.0,
            3.5,
        )
        if rc != 0:
            raise RuntimeError("Neovim Lazy! sync failed")
        t.last_line = "AstroNvim / Lazy plugins synced"

    async def task_gh(self, t: TaskState) -> None:
        proc = await asyncio.create_subprocess_exec(
            "gh", "extension", "list",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        out, _ = await proc.communicate()
        if not out.strip():
            await asyncio.sleep(0.15)
            t.progress = 100.0
            t.last_line = "No extensions installed"
            return

        rc = await self.run_cmd(t, ["gh", "extension", "upgrade", "--all"], "gh extension upgrade", 20.0, 80.0, 2.5)
        if rc != 0:
            raise RuntimeError("gh extension upgrade failed")
        t.last_line = "Extensions upgraded"

    async def task_vscode(self, t: TaskState) -> None:
        rc = await self.run_cmd(t, ["code", "--update-extensions"], "code --update-extensions", 0.0, 100.0, 3.0)
        if rc != 0:
            raise RuntimeError("VS Code extension update failed")
        if not t.last_line:
            t.last_line = "Extensions up to date"

    # ── Orchestrator & DAG Scheduler ──────────────────────────────────

    async def execute_task(self, t: TaskState) -> None:
        while any(self.task_map[d].status in ("queued", "waiting", "running") for d in t.deps):
            dep_names = [self.task_map[d].name for d in t.deps if self.task_map[d].status in ("queued", "waiting", "running")]
            t.status = "waiting"
            t.step_label = f"Waiting on {', '.join(dep_names)}"
            await asyncio.sleep(0.05)

        t.status = "running"
        t.start_time = time.monotonic()
        t.step_label = "Starting..."
        self.log_event(t.name, "Started", "bright_blue")
        try:
            assert t.runner is not None
            await t.runner(t)
            t.progress = 100.0
            t.status = "done"
            t.step_label = "Complete"
            self.log_event(t.name, t.last_line or "Completed", "green")
        except asyncio.CancelledError:
            t.status = "failed"
            t.step_label = "Cancelled"
            raise
        except Exception as exc:
            t.status = "failed"
            if not t.last_line:
                t.last_line = str(exc)
            self.log_event(t.name, f"Failed: {t.last_line}", "bold red")
        finally:
            t.end_time = time.monotonic()

    # ── Rich Renderable Builder ───────────────────────────────────────

    def build_renderable(self, final: bool = False) -> RenderableType:
        total_tasks = len(self.tasks)
        done_tasks = sum(1 for t in self.tasks if t.status in ("done", "failed"))
        failed_tasks = sum(1 for t in self.tasks if t.status == "failed")
        running_tasks = sum(1 for t in self.tasks if t.status == "running")
        overall_pct = sum(t.progress for t in self.tasks) / max(1, total_tasks)
        total_elapsed = time.monotonic() - self.start_time

        # 1. Header Summary Grid
        header_grid = Table.grid(expand=True, padding=(0, 1))
        header_grid.add_column(ratio=1)
        header_grid.add_column(justify="right")

        if done_tasks == total_tasks:
            if failed_tasks == 0:
                status_text = Text(f"✓ All {total_tasks} tasks complete", style="bold bright_green")
            else:
                status_text = Text(f"⚠ {done_tasks - failed_tasks} succeeded, {failed_tasks} failed", style="bold yellow")
        else:
            status_text = Text.assemble(
                ("● ", "bold bright_cyan"),
                (f"{running_tasks} active", "bold white"),
                ("  •  ", "dim"),
                (f"{done_tasks}/{total_tasks} finished", "white"),
            )

        right_meta = Text.assemble(
            status_text,
            ("   ", ""),
            (f"⏱ {total_elapsed:5.1f}s", "bold bright_blue"),
        )
        header_grid.add_row(
            Text("⚡ SYSTEM REFRESH DASHBOARD", style="bold bright_white"),
            right_meta,
        )

        # 2. Overall Progress Bar Row
        overall_bar_grid = Table.grid(expand=True, padding=(0, 1))
        overall_bar_grid.add_column(width=10)
        overall_bar_grid.add_column(ratio=1)
        overall_bar_grid.add_column(width=6, justify="right")

        overall_bar = ProgressBar(
            total=100.0,
            completed=overall_pct,
            style="grey23",
            complete_style="bright_green" if done_tasks == total_tasks and failed_tasks == 0 else "bright_cyan",
            finished_style="bright_green",
        )
        overall_bar_grid.add_row(
            Text("Overall", style="bold dim"),
            overall_bar,
            Text(f"{overall_pct:3.0f}%", style="bold bright_white"),
        )

        # 3. Main Tasks Table
        task_table = Table(
            box=box.SIMPLE_HEAVY,
            expand=True,
            show_header=True,
            header_style="bold dim",
            pad_edge=False,
            padding=(0, 1),
        )
        task_table.add_column("", no_wrap=True)
        task_table.add_column("Task", width=16, no_wrap=True)
        task_table.add_column("Progress", width=18, no_wrap=True)
        task_table.add_column("Done", justify="right", no_wrap=True)
        task_table.add_column("Time", justify="right", no_wrap=True)
        task_table.add_column("Status / Live Output", ratio=1, min_width=18, no_wrap=True, overflow="ellipsis")

        for t in self.tasks:
            if t.status == "done":
                icon: RenderableType = Text("✓", style="bold bright_green")
                name_txt = Text(t.name, style="white")
                bar = ProgressBar(total=100.0, completed=100.0, width=18, style="grey23", complete_style="green", finished_style="bright_green")
                pct_txt = Text("100%", style="green")
                time_txt = Text(f"{t.elapsed:4.1f}s", style="dim")
                detail_txt = Text(t.last_line or "Complete", style="dim")
            elif t.status == "failed":
                icon = Text("✗", style="bold bright_red")
                name_txt = Text(t.name, style="bold bright_red")
                bar = ProgressBar(total=100.0, completed=max(10.0, t.progress), width=18, style="grey23", complete_style="red")
                pct_txt = Text(f"{t.progress:3.0f}%", style="red")
                time_txt = Text(f"{t.elapsed:4.1f}s", style="red")
                detail_txt = Text(t.last_line or "Failed", style="bright_red")
            elif t.status == "running":
                icon = t.spinner
                name_txt = Text(t.name, style="bold bright_white")
                bar = ProgressBar(
                    total=100.0,
                    completed=t.progress,
                    width=18,
                    style="grey23",
                    complete_style="bright_cyan",
                )
                pct_txt = Text(f"{t.progress:3.0f}%", style="bold bright_cyan")
                time_txt = Text(f"{t.elapsed:4.1f}s", style="bright_blue")
                detail_str = f"{t.step_label} · {t.last_line}" if t.last_line else t.step_label
                detail_txt = Text(detail_str, style="bright_cyan")
            else:
                icon = Text("·", style="dim")
                name_txt = Text(t.name, style="dim")
                bar = ProgressBar(total=100.0, completed=0.0, width=18, style="grey23")
                pct_txt = Text("0%", style="dim")
                time_txt = Text("--", style="dim")
                detail_txt = Text(t.step_label, style="dim italic")

            task_table.add_row(icon, name_txt, bar, pct_txt, time_txt, detail_txt)

        components: List[RenderableType] = [
            header_grid,
            Text(""),
            overall_bar_grid,
            task_table,
        ]

        # 4. Live Activity Stream Footer (shown while running in alternate screen)
        if not final and self.activity_feed:
            feed_table = Table.grid(expand=True, padding=(0, 1))
            feed_table.add_column(width=7, style="dim")
            feed_table.add_column(width=16, style="bold dim")
            feed_table.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
            for ts, tname, msg in self.activity_feed:
                feed_table.add_row(ts, tname, Text.from_markup(msg))
            components.append(
                Panel(
                    feed_table,
                    title="[dim]Live Activity Stream[/]",
                    title_align="left",
                    border_style="bright_black",
                    box=box.ROUNDED,
                    padding=(0, 1),
                )
            )

        border_color = "bright_green" if (done_tasks == total_tasks and failed_tasks == 0) else ("yellow" if done_tasks == total_tasks else "bright_blue")
        return Panel(
            Group(*components),
            border_style=border_color,
            box=box.ROUNDED,
            padding=(1, 2),
        )

    async def run(self) -> int:
        # Build DAG task graph
        self.add_task("dotfiles", "Dotfiles", "Phase 1", self.task_dotfiles, deps=[])

        if shutil.which("brew"):
            self.add_task("homebrew", "Homebrew", "Core", self.task_homebrew, deps=["dotfiles"])
        if os.path.isdir(os.path.join(self.home, ".zgenom")):
            self.add_task("zgenom", "Zsh plugins", "Core", self.task_zgenom, deps=["dotfiles"])
        if shutil.which("agy"):
            self.add_task("agy", "Antigravity CLI", "Core", self.task_agy, deps=[])
        if shutil.which("mas"):
            self.add_task("mas", "App Store apps", "Core", self.task_mas, deps=[])
        if shutil.which("softwareupdate"):
            self.add_task("macos", "macOS updates", "Core", self.task_macos, deps=[])

        brew_dep = ["homebrew"] if "homebrew" in self.task_map else []
        if shutil.which("uv"):
            self.add_task("uv", "UV + Python", "Tools", self.task_uv, deps=brew_dep)
        if shutil.which("openclaw"):
            self.add_task("openclaw", "OpenClaw", "Tools", self.task_openclaw, deps=brew_dep)
        if shutil.which("npm"):
            self.add_task("npm", "npm globals", "Tools", self.task_npm, deps=brew_dep)
        if shutil.which("python3"):
            self.add_task("pip", "pip", "Tools", self.task_pip, deps=brew_dep)
        if shutil.which("nvim"):
            self.add_task("nvim", "Neovim plugins", "Tools", self.task_neovim, deps=brew_dep)
        if shutil.which("gh"):
            self.add_task("gh", "GitHub CLI ext", "Tools", self.task_gh, deps=brew_dep)
        if shutil.which("code"):
            self.add_task("vscode", "VS Code ext", "Tools", self.task_vscode, deps=brew_dep)

        workers = [asyncio.create_task(self.execute_task(t)) for t in self.tasks]

        # Run inside Alternate Screen Buffer (screen=True) so zero scrollback pollution occurs
        with Live(
            self.build_renderable(final=False),
            console=self.console,
            screen=True,
            refresh_per_second=15,
        ) as live:
            while not all(w.done() for w in workers):
                live.update(self.build_renderable(final=False))
                await asyncio.sleep(0.06)
            await asyncio.gather(*workers, return_exceptions=True)
            live.update(self.build_renderable(final=False))
            await asyncio.sleep(0.25)

        # Print single static summary dashboard into primary scrollback buffer after exiting alternate screen
        self.console.print(self.build_renderable(final=True))

        failures = [t for t in self.tasks if t.status == "failed"]
        if failures:
            self.console.print("\n[bold bright_red]Failed Task Logs:[/]")
            for t in failures:
                self.console.print(f"[bold red]✗ {t.name}:[/]")
                for log_line in t.logs[-10:]:
                    self.console.print(f"  [dim]{RichEscape(log_line)}[/]")
            return 1

        self.console.print(" [dim]Run 'source ~/.zshrc' if shell configs changed.[/]")
        return 0

    def terminate_children(self) -> None:
        for t in self.tasks:
            if t.proc and t.proc.returncode is None:
                try:
                    os.killpg(os.getpgid(t.proc.pid), signal.SIGTERM)
                except Exception:
                    try:
                        t.proc.terminate()
                    except Exception:
                        pass


def RichEscape(text: str) -> str:
    return text.replace("[", "\\[")


def main() -> int:
    lock_path = f"/tmp/refresh-{os.getuid()}.lock"
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        Console().print("[bold red] ✗  Another 'refresh' instance is already running.[/]")
        return 1

    os.ftruncate(lock_fd, 0)
    os.write(lock_fd, f"{os.getpid()}\n".encode())

    dash = RefreshDashboard()
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)

    def handle_sig() -> None:
        dash.terminate_children()
        for task in asyncio.all_tasks(loop):
            task.cancel()

    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            loop.add_signal_handler(sig, handle_sig)
        except NotImplementedError:
            pass

    try:
        return loop.run_until_complete(dash.run())
    except (KeyboardInterrupt, asyncio.CancelledError):
        dash.terminate_children()
        Console().print("\n[bold yellow] ⚠  Refresh interrupted. Cleaned up background tasks.[/]")
        return 130
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)
            os.unlink(lock_path)
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main())
