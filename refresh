# ── ANSI & Terminal Control ───────────────────────────────────────────
ESC = "\033["
HIDE_CURSOR = f"{ESC}?25l"
SHOW_CURSOR = f"{ESC}?25h"
SYNC_START = f"{ESC}?2026h"
SYNC_END = f"{ESC}?2026l"
CLEAR_LINE = f"{ESC}2K"

RESET = f"{ESC}0m"
BOLD = f"{ESC}1m"
DIM = f"{ESC}2m"

# Nord-inspired TrueColor ANSI palette
C_CYAN = f"{ESC}38;2;136;192;208m"     # #88C0D0
C_BLUE = f"{ESC}38;2;129;161;193m"     # #81A1C1
C_GREEN = f"{ESC}38;2;163;190;140m"    # #A3BE8C
C_YELLOW = f"{ESC}38;2;235;203;139m"   # #EBCB8B
C_RED = f"{ESC}38;2;191;97;106m"       # #BF616A
C_PURPLE = f"{ESC}38;2;180;142;173m"   # #B48EAD
C_GRAY = f"{ESC}38;2;108;118;138m"     # #6C768A
C_DARK = f"{ESC}38;2;67;76;94m"        # #434C5E
C_WHITE = f"{ESC}38;2;236;239;244m"    # #ECEFF4

SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
BLOCKS = [" ", "▏", "▎", "▍", "▌", "▋", "▊", "▉", "█"]

ANSI_ESCAPE_RE = re.compile(r"\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")


def strip_ansi(text: str) -> str:
    return ANSI_ESCAPE_RE.sub("", text)


def char_width(ch: str) -> int:
    if unicodedata.combining(ch) or ch in ("\ufe0f", "\ufe0e", "\u200d"):
        return 0
    if unicodedata.east_asian_width(ch) in ("W", "F"):
        return 2
    return 1


def display_width(text: str) -> int:
    return sum(char_width(c) for c in strip_ansi(text))


def fit_width(text: str, target_w: int) -> str:
    clean = "".join(c for c in strip_ansi(text) if c >= " " and ch_printable(c))
    cur_w = 0
    out = []
    for c in clean:
        w = char_width(c)
        if cur_w + w > target_w - 1 and display_width(clean) > target_w:
            out.append("…")
            cur_w += 1
            break
        out.append(c)
        cur_w += w
    return "".join(out) + (" " * max(0, target_w - cur_w))


def ch_printable(c: str) -> bool:
    return c not in ("\r", "\n", "\t", "\ufe0f", "\ufe0e")


@dataclass
class StepSpec:
    label: str
    cmd: List[str]
    weight: float = 1.0
    env: Optional[dict] = None
    cwd: Optional[str] = None
    ignore_error: bool = False


@dataclass
class TaskState:
    id: str
    name: str
    deps: List[str] = field(default_factory=list)
    status: str = "queued"  # queued, waiting, running, done, failed, skipped
    progress: float = 0.0   # 0.0 to 1.0
    target_progress: float = 0.0
    step_label: str = "Queued"
    last_line: str = ""
    logs: List[str] = field(default_factory=list)
    start_time: Optional[float] = None
    end_time: Optional[float] = None
    expected_duration: float = 8.0
    runner: Optional[Callable[["TaskState"], Coroutine]] = None
    proc: Optional[asyncio.subprocess.Process] = None

    @property
    def elapsed(self) -> float:
        if self.start_time is None:
            return 0.0
        end = self.end_time if self.end_time is not None else time.monotonic()
        return max(0.0, end - self.start_time)


class RefreshDashboard:
    def __init__(self) -> None:
        self.home = os.path.expanduser("~")
        self.dotfiles_dir = os.path.join(self.home, "dotfiles")
        self.tasks: List[TaskState] = []
        self.task_map: dict[str, TaskState] = {}
        self.npm_lock = asyncio.Lock()
        self.start_time = time.monotonic()
        self.frame_idx = 0
        self.rendered_lines = 0
        self.is_tty = sys.stdout.isatty()
        self.cancelled = False

    def add_task(
        self,
        task_id: str,
        name: str,
        runner: Callable[[TaskState], Coroutine],
        deps: Optional[List[str]] = None,
        expected_duration: float = 8.0,
    ) -> None:
        t = TaskState(
            id=task_id,
            name=name,
            deps=deps or [],
            runner=runner,
            expected_duration=expected_duration,
        )
        self.tasks.append(t)
        self.task_map[task_id] = t

    async def run_cmd(
        self,
        task: TaskState,
        cmd: List[str],
        step_label: str,
        base_progress: float,
        span_progress: float,
        expected_sec: float = 5.0,
        cwd: Optional[str] = None,
        env_overrides: Optional[dict] = None,
    ) -> int:
        task.step_label = step_label
        task.target_progress = base_progress + span_progress * 0.88
        env = os.environ.copy()
        if env_overrides:
            env.update(env_overrides)

        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdin=asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
            cwd=cwd,
            env=env,
            start_new_session=True,
        )
        task.proc = proc
        t0 = time.monotonic()

        async def read_stream() -> None:
            assert proc.stdout is not None
            buf = b""
            while True:
                chunk = await proc.stdout.read(256)
                if not chunk:
                    break
                buf += chunk
                parts = re.split(b"[\r\n]+", buf)
                buf = parts[-1]
                for raw in parts[:-1]:
                    line = strip_ansi(raw.decode("utf-8", errors="replace")).strip()
                    if line:
                        task.last_line = line
                        task.logs.append(line)
            if buf:
                line = strip_ansi(buf.decode("utf-8", errors="replace")).strip()
                if line:
                    task.last_line = line
                    task.logs.append(line)

        reader_task = asyncio.create_task(read_stream())
        try:
            while proc.returncode is None:
                await asyncio.sleep(0.05)
                dt = time.monotonic() - t0
                ratio = 1.0 - math.exp(-dt / max(0.5, expected_sec))
                task.progress = max(
                    task.progress,
                    base_progress + span_progress * min(0.92, ratio * 0.90),
                )
            await reader_task
        finally:
            task.proc = None

        task.progress = base_progress + span_progress
        return proc.returncode or 0

