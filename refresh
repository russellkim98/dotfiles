#!/usr/bin/env bash
# refresh — Update everything on this system. Fast, safe, and comprehensive.
#
# Phase 1 (Sequential): Dotfiles & symlinks (updates Brewfile/configs first)
# Phase 2 (Parallel):   Core system & standalone managers (Homebrew, Zsh, agy, macOS)
# Phase 3 (Parallel):   Tool ecosystems & plugins that depend on Homebrew runtimes
#                       (UV + Python, OpenClaw, npm, Neovim, GitHub CLI, VS Code)

set -uo pipefail

# ── Non-interactive environment (prevent background /dev/tty hangs) ───
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
export LANGUAGE="en_US:en"
export NONINTERACTIVE=1
export CI=1
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -o BatchMode=yes"
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1

# ── Colors & formatting ───────────────────────────────────────────────
BLUE='\033[1;34m'    GREEN='\033[1;32m'   YELLOW='\033[1;33m'
RED='\033[1;31m'     DIM='\033[2m'        BOLD='\033[1m'
NC='\033[0m'

info()    { printf "${BLUE}==>${NC} %s\n" "$1"; }
success() { printf "${GREEN} ✓${NC}  %s\n" "$1"; }
warn()    { printf "${YELLOW} ⚠${NC}  %s\n" "$1"; }
fail()    { printf "${RED} ✗${NC}  %s\n" "$1"; }

TOTAL_START=$SECONDS
TOTAL_FAILURES=0
TOTAL_SUCCEEDED=0

# ── Single-instance lock & temp dir for per-task logs ─────────────────
LOCK_DIR="/tmp/refresh-${UID}.lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    old_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        fail "Another 'refresh' instance (PID $old_pid) is already running."
        exit 1
    fi
    rm -rf "$LOCK_DIR"
    mkdir -p "$LOCK_DIR"
fi
echo "$$" > "$LOCK_DIR/pid"

TASK_DIR=$(mktemp -d)
declare -a PIDS=() NAMES=()

cleanup() {
    local sig="${1:-EXIT}"
    if [ "${#PIDS[@]}" -gt 0 ]; then
        for pid in "${PIDS[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                pkill -TERM -P "$pid" 2>/dev/null || true
                kill -TERM "$pid" 2>/dev/null || true
            fi
        done
        wait "${PIDS[@]}" 2>/dev/null || true
    fi
    rm -rf "$TASK_DIR" "$LOCK_DIR"
    if [ "$sig" != "EXIT" ]; then
        printf "\n${YELLOW} ⚠  Refresh interrupted (${sig}). Cleaned up background tasks.${NC}\n"
        exit 130
    fi
}
trap 'cleanup INT'  INT
trap 'cleanup TERM' TERM
trap 'cleanup EXIT' EXIT

# ── Parallel task runner ──────────────────────────────────────────────

# Launch a named task in the background, capturing output & elapsed time.
run_task() {
    local name="$1"; shift
    local slug="${name//[^a-zA-Z0-9_-]/_}"
    local logfile="$TASK_DIR/$slug.log"
    local timefile="$TASK_DIR/$slug.time"
    (
        t0=$SECONDS
        trap 'echo "$((SECONDS - t0))" > "$timefile"' EXIT
        set -eo pipefail
        "$@"
    ) < /dev/null > "$logfile" 2>&1 &
    PIDS+=($!)
    NAMES+=("$name")
}

# Wait for all launched tasks in the current phase and print results.
wait_tasks() {
    local phase_failures=0
    for i in "${!PIDS[@]}"; do
        local name="${NAMES[$i]}"
        local slug="${name//[^a-zA-Z0-9_-]/_}"
        local logfile="$TASK_DIR/$slug.log"
        local timefile="$TASK_DIR/$slug.time"
        local rc=0
        wait "${PIDS[$i]}" 2>/dev/null || rc=$?

        local dur=""
        if [ -f "$timefile" ]; then
            dur=" ${DIM}($(cat "$timefile")s)${NC}"
        fi

        if [ "$rc" -eq 0 ]; then
            printf "${GREEN} ✓${NC}  %s%b\n" "$name" "$dur"
            TOTAL_SUCCEEDED=$((TOTAL_SUCCEEDED + 1))
        else
            printf "${RED} ✗${NC}  %s%b\n" "$name" "$dur"
            phase_failures=$((phase_failures + 1))
            TOTAL_FAILURES=$((TOTAL_FAILURES + 1))
        fi

        # Print captured output, indented and dimmed (strip carriage-return noise)
        if [ -s "$logfile" ]; then
            printf "${DIM}"
            tr '\r' '\n' < "$logfile" | sed -e '/^[[:space:]]*$/d' -e 's/^/     /'
            printf "${NC}"
        fi
    done
    PIDS=() NAMES=()
    return $phase_failures
}

# Serialize global npm mutations so OpenClaw and npm never race on node_modules.
with_npm_lock() {
    local npm_lock="$TASK_DIR/npm_global.lock"
    while ! mkdir "$npm_lock" 2>/dev/null; do
        sleep 0.2
    done
    local rc=0
    "$@" || rc=$?
    rmdir "$npm_lock" 2>/dev/null || true
    return $rc
}

# ── Task definitions ─────────────────────────────────────────────────

task_dotfiles() {
    local dotfiles_dir="$1"
    # Reset auto-generated Neovim lockfile if tracked in a submodule
    if [ -d "$dotfiles_dir/astronvim_template/.git" ] || [ -f "$dotfiles_dir/astronvim_template/.git" ]; then
        git -C "$dotfiles_dir/astronvim_template" checkout -- lazy-lock.json 2>/dev/null || true
    fi
    git -C "$dotfiles_dir" pull --rebase --autostash
    if [ -f "$dotfiles_dir/.gitmodules" ]; then
        git -C "$dotfiles_dir" submodule update --init --recursive --force
    fi
    if [ -f "$dotfiles_dir/symlink.sh" ]; then
        chmod +x "$dotfiles_dir/symlink.sh"
        "$dotfiles_dir/symlink.sh"
    fi
    if [ -d "/Applications/iTerm.app" ] && [ -f "$dotfiles_dir/iterm2-theme.json" ]; then
        local iterm_dir="$HOME/Library/Application Support/iTerm2/DynamicProfiles"
        mkdir -p "$iterm_dir" 2>/dev/null || true
        python3 -c '
import sys, json
with open(sys.argv[1]) as f:
    profile = json.load(f)
profile["Dynamic Profile Parent Name"] = "Default"
with open(sys.argv[2], "w") as out:
    json.dump({"Profiles": [profile]}, out, indent=2)
' "$dotfiles_dir/iterm2-theme.json" "$iterm_dir/dotfiles-profile.json" 2>/dev/null || true
    fi
}

task_homebrew() {
    local dotfiles_dir="$1"
    brew update
    export HOMEBREW_NO_AUTO_UPDATE=1
    brew upgrade --greedy-auto-updates
    if [ -f "$dotfiles_dir/Brewfile" ]; then
        brew bundle check --file="$dotfiles_dir/Brewfile" >/dev/null 2>&1 \
            || brew bundle install --file="$dotfiles_dir/Brewfile" --no-upgrade
    fi
    brew autoremove
    brew cleanup --prune=all
}

task_zgenom() {
    zsh -c '
        set -e
        source "$HOME/.zgenom/zgenom.zsh"
        zgenom selfupdate
        zgenom update
        rm -f "$HOME"/.zcompdump*
        source "$HOME/.zshrc" >/dev/null 2>&1 || true
    '
}

task_agy() {
    agy update
}

task_macos_updates() {
    softwareupdate -l
}

task_mas() {
    mas upgrade
}

task_uv() {
    local uv_path real_uv_path
    uv_path=$(command -v uv)
    real_uv_path=$(realpath "$uv_path" 2>/dev/null || echo "$uv_path")
    if [[ "$real_uv_path" == *"Cellar/uv"* || "$real_uv_path" == *"homebrew"* || "$uv_path" == "/opt/homebrew/"* ]]; then
        echo "UV binary is managed by Homebrew — skipping self-update."
    else
        uv self update
    fi

    # Upgrade uv-managed Python installations
    if [ -n "$(uv python list --only-installed 2>/dev/null)" ]; then
        uv python upgrade
    fi

    # Upgrade uv-managed CLI tools (ruff, nano-pdf, etc.)
    if [ -n "$(uv tool list 2>/dev/null)" ]; then
        uv tool upgrade --all
    else
        echo "No uv tools installed."
    fi
}

task_openclaw() {
    with_npm_lock openclaw update --yes
}

task_npm() {
    local npm_path real_npm_path
    npm_path=$(command -v npm)
    real_npm_path=$(realpath "$npm_path" 2>/dev/null || echo "$npm_path")

    # Do not overwrite Homebrew's npm symlink if node is managed by Homebrew
    if [[ "$real_npm_path" == *"Cellar/node"* || "$real_npm_path" == *"homebrew"* ]]; then
        echo "npm is bundled with Homebrew node — skipping npm self-overwrite."
    else
        with_npm_lock npm install -g npm
    fi

    # Upgrade other global npm packages (excluding npm & openclaw which has its own updater)
    local pkgs
    pkgs=$(npm list -g --depth=0 --parseable 2>/dev/null \
        | tail -n +2 \
        | sed 's|.*/node_modules/||' \
        | grep -Ev '^(npm|openclaw)$' || true)

    if [ -n "$pkgs" ]; then
        # shellcheck disable=SC2086
        with_npm_lock npm update -g $pkgs
    else
        echo "No additional global npm packages to update."
    fi
}

task_pip() {
    local py_path real_py_path
    py_path=$(command -v python3)
    real_py_path=$(realpath "$py_path" 2>/dev/null || echo "$py_path")

    if [[ "$py_path" == "/usr/bin/python3" || "$real_py_path" == "/Library/Developer/"* || "$real_py_path" == "/System/"* ]]; then
        echo "python3 is macOS system/Xcode Python — skipping global pip upgrade."
        return 0
    fi

    if python3 -c "
import sysconfig, os
for scheme in ['stdlib', 'platstdlib', 'purelib', 'platlib']:
    try:
        path = sysconfig.get_path(scheme)
        if path and os.path.exists(os.path.join(path, 'EXTERNALLY-MANAGED')):
            exit(0)
    except Exception:
        pass
exit(1)
" 2>/dev/null; then
        echo "Python is externally managed (PEP 668) — skipping global pip upgrade."
    else
        python3 -m pip install --upgrade pip
    fi
}

task_neovim() {
    nvim --headless "+Lazy! sync" +qa
    echo "Lazy plugins synced."
}

task_gh_extensions() {
    if [ -n "$(gh extension list 2>/dev/null)" ]; then
        gh extension upgrade --all
    else
        echo "No GitHub CLI extensions installed."
    fi
}

task_vscode_extensions() {
    code --update-extensions
}

# ══════════════════════════════════════════════════════════════════════
#  Phase 1: Dotfiles (sequential — updates Brewfile and configs first)
# ══════════════════════════════════════════════════════════════════════

DOTFILES_DIR="$HOME/dotfiles"

printf "\n${BOLD}Phase 1: Dotfiles${NC}\n\n"

if [ -d "$DOTFILES_DIR/.git" ]; then
    run_task "Dotfiles" task_dotfiles "$DOTFILES_DIR"
    wait_tasks || warn "Dotfiles encountered an issue — continuing with tool updates"
else
    warn "Dotfiles — ~/dotfiles not found, skipping"
fi

# ══════════════════════════════════════════════════════════════════════
#  Phase 2: Core System & Standalone Managers (parallel)
# ══════════════════════════════════════════════════════════════════════

printf "\n${BOLD}Phase 2: Core system & package managers (parallel)${NC}\n\n"

command -v brew           >/dev/null 2>&1 && run_task "Homebrew"          task_homebrew "$DOTFILES_DIR"
[ -d "$HOME/.zgenom" ]                    && run_task "Zsh plugins"      task_zgenom
command -v agy            >/dev/null 2>&1 && run_task "Antigravity CLI"   task_agy
command -v mas            >/dev/null 2>&1 && run_task "App Store apps"    task_mas
command -v softwareupdate >/dev/null 2>&1 && run_task "macOS updates"     task_macos_updates

wait_tasks || true

# ══════════════════════════════════════════════════════════════════════
#  Phase 3: Tool Ecosystems & Plugins (parallel, post-Homebrew)
# ══════════════════════════════════════════════════════════════════════

printf "\n${BOLD}Phase 3: Tool ecosystems & plugins (parallel)${NC}\n\n"

command -v uv             >/dev/null 2>&1 && run_task "UV + Python/tools" task_uv
command -v openclaw       >/dev/null 2>&1 && run_task "OpenClaw"          task_openclaw
command -v npm            >/dev/null 2>&1 && run_task "npm globals"       task_npm
command -v python3        >/dev/null 2>&1 && run_task "pip"               task_pip
command -v nvim           >/dev/null 2>&1 && run_task "Neovim plugins"    task_neovim
command -v gh             >/dev/null 2>&1 && run_task "GitHub CLI ext"    task_gh_extensions
command -v code           >/dev/null 2>&1 && run_task "VS Code ext"       task_vscode_extensions

wait_tasks || true

# ══════════════════════════════════════════════════════════════════════
#  Summary
# ══════════════════════════════════════════════════════════════════════

elapsed=$((SECONDS - TOTAL_START))
if [ "$TOTAL_FAILURES" -eq 0 ]; then
    printf "\n${GREEN}${BOLD}Refresh complete in ${elapsed}s! (${TOTAL_SUCCEEDED} succeeded)${NC}\n"
    printf "${DIM}Run 'source ~/.zshrc' if environment variables changed.${NC}\n"
    exit 0
else
    printf "\n${YELLOW}${BOLD}Refresh finished in ${elapsed}s (${TOTAL_SUCCEEDED} succeeded, ${TOTAL_FAILURES} failed).${NC}\n"
    printf "${DIM}Review failed tasks above. Run 'source ~/.zshrc' if environment variables changed.${NC}\n"
    exit 1
fi
