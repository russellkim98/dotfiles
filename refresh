ANSI_ESCAPE_RE = re.compile(r"\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")


def strip_ansi(text: str) -> str:
    return ANSI_ESCAPE_RE.sub("", text)


@dataclass
class TaskState:
    id: str
    name: str
    category: str
    deps: List[str] = field(default_factory=list)
    status: str = "queued"  # queued, waiting, running, done, failed
    progress: float = 0.0   # 0.0 to 100.0
    step_label: str = "Queued"
    last_line: str = ""
    logs: List[str] = field(default_factory=list)
    start_time: Optional[float] = None
    end_time: Optional[float] = None
    runner: Optional[Callable[["TaskState"], Coroutine]] = None
    proc: Optional[asyncio.subprocess.Process] = None
    spinner: Spinner = field(default_factory=lambda: Spinner("dots", style="bold bright_cyan"))

    @property
    def elapsed(self) -> float:
        if self.start_time is None:
            return 0.0
        end = self.end_time if self.end_time is not None else time.monotonic()
        return max(0.0, end - self.start_time)


class RefreshDashboard:
    def __init__(self) -> None:
        self.console = Console()
        self.home = os.path.expanduser("~")
        self.dotfiles_dir = os.path.join(self.home, "dotfiles")
        self.tasks: List[TaskState] = []
        self.task_map: dict[str, TaskState] = {}
        self.npm_lock = asyncio.Lock()
        self.start_time = time.monotonic()
        self.activity_feed: Deque[tuple[str, str, str]] = deque(maxlen=6)

    def add_task(
        self,
        task_id: str,
        name: str,
        category: str,
        runner: Callable[[TaskState], Coroutine],
        deps: Optional[List[str]] = None,
    ) -> None:
        t = TaskState(
            id=task_id,
            name=name,
            category=category,
            deps=deps or [],
            runner=runner,
        )
        self.tasks.append(t)
        self.task_map[task_id] = t

    def log_event(self, task_name: str, message: str, style: str = "dim") -> None:
        ts = f"{time.monotonic() - self.start_time:5.1f}s"
        self.activity_feed.append((ts, task_name, f"[{style}]{ RichEscape(message) }[/]"))

    async def run_cmd(
        self,
        task: TaskState,
        cmd: List[str],
        step_label: str,
        base_pct: float,
        span_pct: float,
        expected_sec: float = 5.0,
        cwd: Optional[str] = None,
        env_overrides: Optional[dict] = None,
    ) -> int:
        task.step_label = step_label
        env = os.environ.copy()
        if env_overrides:
            env.update(env_overrides)

        proc = await asyncio.create_subprocess_exec(
            *cmd,
            stdin=asyncio.subprocess.DEVNULL,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT,
            cwd=cwd,
            env=env,
            start_new_session=True,
        )
        task.proc = proc
        t0 = time.monotonic()

        async def read_stream() -> None:
            assert proc.stdout is not None
            buf = b""
            while True:
                chunk = await proc.stdout.read(256)
                if not chunk:
                    break
                buf += chunk
                parts = re.split(b"[\r\n]+", buf)
                buf = parts[-1]
                for raw in parts[:-1]:
                    line = strip_ansi(raw.decode("utf-8", errors="replace")).strip()
                    if line:
                        task.last_line = line
                        task.logs.append(line)
                        self.log_event(task.name, line, "cyan")
            if buf:
                line = strip_ansi(buf.decode("utf-8", errors="replace")).strip()
                if line:
                    task.last_line = line
                    task.logs.append(line)
                    self.log_event(task.name, line, "cyan")

        reader_task = asyncio.create_task(read_stream())
        try:
            while proc.returncode is None:
                await asyncio.sleep(0.05)
                dt = time.monotonic() - t0
                ratio = 1.0 - math.exp(-dt / max(0.5, expected_sec))
                task.progress = max(
                    task.progress,
                    base_pct + span_pct * min(0.92, ratio * 0.90),
                )
            await reader_task
        finally:
            task.proc = None

        task.progress = base_pct + span_pct
        return proc.returncode or 0

    # ── Task Implementations ──────────────────────────────────────────

    async def task_dotfiles(self, t: TaskState) -> None:
        if not os.path.isdir(os.path.join(self.dotfiles_dir, ".git")):
            t.last_line = "~/dotfiles not found, skipped"
            t.progress = 100.0
            return

        sub_git = os.path.join(self.dotfiles_dir, "astronvim_template", ".git")
        if os.path.exists(sub_git):
            await self.run_cmd(
                t,
                ["git", "-C", os.path.join(self.dotfiles_dir, "astronvim_template"), "checkout", "--", "lazy-lock.json"],
                "Reset lockfile",
                0.0,
                10.0,
                1.0,
            )

        rc = await self.run_cmd(
            t,
            ["git", "-C", self.dotfiles_dir, "pull", "--rebase", "--autostash"],
            "git pull --rebase",
            10.0,
            50.0,
            2.5,
        )
        if rc != 0:
            raise RuntimeError("git pull failed")

        if os.path.isfile(os.path.join(self.dotfiles_dir, ".gitmodules")):
            rc = await self.run_cmd(
                t,
                ["git", "-C", self.dotfiles_dir, "submodule", "update", "--init", "--recursive", "--force"],
                "git submodule update",
                60.0,
                15.0,
                2.0,
            )
            if rc != 0:
                raise RuntimeError("git submodule update failed")

        symlink_sh = os.path.join(self.dotfiles_dir, "symlink.sh")
        if os.path.isfile(symlink_sh):
            os.chmod(symlink_sh, 0o755)
            rc = await self.run_cmd(t, [symlink_sh], "Linking dotfiles", 75.0, 25.0, 1.0)
            if rc != 0:
                raise RuntimeError("symlink.sh failed")

        t.last_line = "Synced & linked"

    async def task_homebrew(self, t: TaskState) -> None:
        rc = await self.run_cmd(
            t,
            ["brew", "update"],
            "brew update",
            0.0,
            22.0,
            4.0,
            env_overrides={"HOMEBREW_NO_AUTO_UPDATE": "0"},
        )
        if rc != 0:
            raise RuntimeError("brew update failed")

        rc = await self.run_cmd(
            t,
            ["brew", "upgrade", "--greedy-auto-updates"],
            "brew upgrade",
            22.0,
            40.0,
            8.0,
        )
        if rc != 0:
            raise RuntimeError("brew upgrade failed")

        brewfile = os.path.join(self.dotfiles_dir, "Brewfile")
        if os.path.isfile(brewfile):
            chk = await self.run_cmd(
                t,
                ["brew", "bundle", "check", f"--file={brewfile}"],
                "brew bundle check",
                62.0,
                10.0,
                1.5,
            )
            if chk != 0:
                rc = await self.run_cmd(
                    t,
                    ["brew", "bundle", "install", f"--file={brewfile}", "--no-upgrade"],
                    "brew bundle install",
                    72.0,
                    10.0,
                    5.0,
                )
                if rc != 0:
                    raise RuntimeError("brew bundle install failed")
        else:
            t.progress = 82.0

        rc = await self.run_cmd(t, ["brew", "autoremove"], "brew autoremove", 82.0, 8.0, 1.5)
        if rc != 0:
            raise RuntimeError("brew autoremove failed")

        rc = await self.run_cmd(t, ["brew", "cleanup", "--prune=all"], "brew cleanup", 90.0, 10.0, 2.5)
        if rc != 0:
            raise RuntimeError("brew cleanup failed")

        t.last_line = "Formulae, casks & Brewfile up to date"

