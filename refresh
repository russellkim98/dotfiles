    # ── Orchestrator & DAG Scheduler ──────────────────────────────────

    async def execute_task(self, t: TaskState) -> None:
        # Wait for dependencies
        while any(self.task_map[d].status in ("queued", "waiting", "running") for d in t.deps):
            dep_names = [self.task_map[d].name for d in t.deps if self.task_map[d].status in ("queued", "waiting", "running")]
            t.status = "waiting"
            t.step_label = f"Waiting on {', '.join(dep_names)}"
            await asyncio.sleep(0.05)

        t.status = "running"
        t.start_time = time.monotonic()
        t.step_label = "Starting..."
        try:
            assert t.runner is not None
            await t.runner(t)
            t.progress = 1.0
            t.status = "done"
            t.step_label = "Complete"
        except asyncio.CancelledError:
            t.status = "failed"
            t.step_label = "Cancelled"
            raise
        except Exception as exc:
            t.status = "failed"
            if not t.last_line:
                t.last_line = str(exc)
        finally:
            t.end_time = time.monotonic()

    # ── Smooth Unicode Progress Bar Renderer ──────────────────────────

    def format_bar(self, progress: float, width: int, status: str) -> str:
        progress = max(0.0, min(1.0, progress))
        total_eighths = int(round(progress * width * 8))
        full_blocks = total_eighths // 8
        rem = total_eighths % 8

        filled = "█" * full_blocks
        if full_blocks < width:
            partial = BLOCKS[rem] if rem > 0 else "░"
            empty = "░" * max(0, width - full_blocks - 1)
        else:
            partial = ""
            empty = ""

        if status == "done":
            color = C_GREEN
        elif status == "failed":
            color = C_RED
        elif status == "running":
            color = C_CYAN
        else:
            color = C_DARK

        return f"{color}{filled}{partial}{C_DARK}{empty}{RESET}"

    def render_frame(self) -> None:
        if not self.is_tty:
            return

        cols, _ = shutil.get_terminal_size((100, 30))
        cols = max(72, min(cols, 120))
        inner_w = cols - 4  # Inside " │ " and " │"

        total_tasks = len(self.tasks)
        done_tasks = sum(1 for t in self.tasks if t.status in ("done", "failed"))
        running_tasks = sum(1 for t in self.tasks if t.status == "running")
        overall_prog = sum(t.progress for t in self.tasks) / max(1, total_tasks)
        total_elapsed = time.monotonic() - self.start_time
        spin = SPINNER_FRAMES[self.frame_idx % len(SPINNER_FRAMES)]

        lines: List[str] = []

        # Top border
        lines.append(f" {C_DARK}╭{'─' * (cols - 2)}╮{RESET}")

        # Header title + overall timer
        title_left = f"{BOLD}{C_WHITE}SYSTEM REFRESH{RESET}"
        if done_tasks == total_tasks:
            status_badge = d_count_str(self.tasks)
        else:
            status_badge = f"{C_CYAN}{spin}{RESET} {C_WHITE}{running_tasks} active{RESET} {C_GRAY}•{RESET} {C_WHITE}{done_tasks}/{total_tasks}{RESET}"
        timer_str = f"{C_BLUE}{BOLD}{total_elapsed:5.1f}s{RESET}"

        right_part = f"{status_badge}   {timer_str}"
        pad1 = max(1, inner_w - display_width(title_left) - display_width(right_part))
        lines.append(f" {C_DARK}│{RESET} {title_left}{' ' * pad1}{right_part} {C_DARK}│{RESET}")

        # Overall progress bar row
        pct_str = f"{int(round(overall_prog * 100)):3d}%"
        overall_label = "Overall  "
        overall_bar_w = max(16, inner_w - len(overall_label) - 1 - len(pct_str))
        overall_bar = self.format_bar(
            overall_prog,
            overall_bar_w,
            "done" if done_tasks == total_tasks and all(t.status == "done" for t in self.tasks) else "running",
        )
        lines.append(
            f" {C_DARK}│{RESET} {C_GRAY}{overall_label}{RESET}{overall_bar} {BOLD}{C_WHITE}{pct_str}{RESET} {C_DARK}│{RESET}"
        )

        # Divider
        lines.append(f" {C_DARK}├{'─' * (cols - 2)}┤{RESET}")

        # Task rows
        name_w = 16
        bar_w = 16
        for t in self.tasks:
            if t.status == "done":
                icon = f"{C_GREEN}✓{RESET}"
                name_col = f"{C_WHITE}{t.name:<{name_w}}{RESET}"
            elif t.status == "failed":
                icon = f"{C_RED}✗{RESET}"
                name_col = f"{C_RED}{t.name:<{name_w}}{RESET}"
            elif t.status == "running":
                icon = f"{C_CYAN}{spin}{RESET}"
                name_col = f"{BOLD}{C_WHITE}{t.name:<{name_w}}{RESET}"
            else:
                icon = f"{C_GRAY}⋯{RESET}"
                name_col = f"{C_GRAY}{t.name:<{name_w}}{RESET}"

            bar = self.format_bar(t.progress, bar_w, t.status)
            tpct = f"{int(round(t.progress * 100)):3d}%"
            pct_col = f"{C_WHITE if t.status == 'running' else C_GRAY}{tpct}{RESET}"

            if t.start_time is not None:
                time_col = f"{C_BLUE if t.status == 'running' else C_GRAY}{t.elapsed:5.1f}s{RESET}"
            else:
                time_col = f"{C_DARK}   -- {RESET}"

            left_prefix = f"{icon} {name_col} {bar} {pct_col} {time_col}  "
            avail_detail_w = max(8, inner_w - display_width(left_prefix))

            if t.status in ("done", "failed") and t.last_line:
                raw_detail = t.last_line
            elif t.status != "running":
                raw_detail = t.step_label
            else:
                raw_detail = f"{t.step_label} · {t.last_line}" if t.last_line else t.step_label

            detail_padded = fit_width(raw_detail, avail_detail_w)
            detail_col = f"{C_RED if t.status == 'failed' else (C_GRAY if t.status != 'running' else C_BLUE)}{detail_padded}{RESET}"

            row = f" {C_DARK}│{RESET} {left_prefix}{detail_col} {C_DARK}│{RESET}"
            lines.append(row)

        # Bottom border
        lines.append(f" {C_DARK}╰{'─' * (cols - 2)}╯{RESET}")

        out = [SYNC_START]
        if self.rendered_lines > 0:
            out.append(f"{ESC}{self.rendered_lines}A\r")
        for line in lines:
            out.append(f"{CLEAR_LINE}{line}\n")
        out.append(SYNC_END)

        sys.stdout.write("".join(out))
        sys.stdout.flush()
        self.rendered_lines = len(lines)

    async def run(self) -> int:
        # Build task graph
        self.add_task("dotfiles", "Dotfiles", self.task_dotfiles, deps=[], expected_duration=3.0)

        if shutil.which("brew"):
            self.add_task("homebrew", "Homebrew", self.task_homebrew, deps=["dotfiles"], expected_duration=12.0)
        if os.path.isdir(os.path.join(self.home, ".zgenom")):
            self.add_task("zgenom", "Zsh plugins", self.task_zgenom, deps=["dotfiles"], expected_duration=5.0)
        if shutil.which("agy"):
            self.add_task("agy", "Antigravity CLI", self.task_agy, deps=[], expected_duration=3.0)
        if shutil.which("mas"):
            self.add_task("mas", "App Store apps", self.task_mas, deps=[], expected_duration=6.0)
        if shutil.which("softwareupdate"):
            self.add_task("macos", "macOS updates", self.task_macos, deps=[], expected_duration=10.0)

        brew_dep = ["homebrew"] if "homebrew" in self.task_map else []
        if shutil.which("uv"):
            self.add_task("uv", "UV + Python", self.task_uv, deps=brew_dep, expected_duration=4.0)
        if shutil.which("openclaw"):
            self.add_task("openclaw", "OpenClaw", self.task_openclaw, deps=brew_dep, expected_duration=5.0)
        if shutil.which("npm"):
            self.add_task("npm", "npm globals", self.task_npm, deps=brew_dep, expected_duration=4.0)
        if shutil.which("python3"):
            self.add_task("pip", "pip", self.task_pip, deps=brew_dep, expected_duration=1.0)
        if shutil.which("nvim"):
            self.add_task("nvim", "Neovim plugins", self.task_neovim, deps=brew_dep, expected_duration=4.0)
        if shutil.which("gh"):
            self.add_task("gh", "GitHub CLI ext", self.task_gh, deps=brew_dep, expected_duration=3.0)
        if shutil.which("code"):
            self.add_task("vscode", "VS Code ext", self.task_vscode, deps=brew_dep, expected_duration=4.0)

        if self.is_tty:
            sys.stdout.write("\n" + HIDE_CURSOR)
            sys.stdout.flush()

        workers = [asyncio.create_task(self.execute_task(t)) for t in self.tasks]

        try:
            while not all(w.done() for w in workers):
                self.frame_idx += 1
                self.render_frame()
                await asyncio.sleep(0.06)
            await asyncio.gather(*workers, return_exceptions=True)
            self.frame_idx += 1
            self.render_frame()
        finally:
            if self.is_tty:
                sys.stdout.write(SHOW_CURSOR)
                sys.stdout.flush()

        # Print any failure logs clearly below the dashboard
        failures = [t for t in self.tasks if t.status == "failed"]
        if failures:
            print(f"\n {C_RED}{BOLD}Failed Task Logs:{RESET}")
            for t in failures:
                print(f" {C_RED}✗ {t.name}:{RESET}")
                for log_line in t.logs[-10:]:
                    print(f"   {DIM}{log_line}{RESET}")
            return 1

        print(f" {C_GRAY}Run 'source ~/.zshrc' if shell configs changed.{RESET}")
        return 0

    def terminate_children(self) -> None:
        for t in self.tasks:
            if t.proc and t.proc.returncode is None:
                try:
                    os.killpg(os.getpgid(t.proc.pid), signal.SIGTERM)
                except Exception:
                    try:
                        t.proc.terminate()
                    except Exception:
                        pass


def d_count_str(tasks: List[TaskState]) -> str:
    fails = sum(1 for t in tasks if t.status == "failed")
    ok = sum(1 for t in tasks if t.status == "done")
    if fails == 0:
        return f"{C_GREEN}{BOLD}✓ All {ok} tasks complete{RESET}"
    return f"{C_YELLOW}{BOLD}{ok} done, {fails} failed{RESET}"


def main() -> int:
    lock_path = f"/tmp/refresh-{os.getuid()}.lock"
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print(f"{C_RED} ✗  Another 'refresh' instance is already running.{RESET}")
        return 1

    os.ftruncate(lock_fd, 0)
    os.write(lock_fd, f"{os.getpid()}\n".encode())

    dash = RefreshDashboard()
    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)

    def handle_sig() -> None:
        dash.terminate_children()
        for task in asyncio.all_tasks(loop):
            task.cancel()

    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            loop.add_signal_handler(sig, handle_sig)
        except NotImplementedError:
            pass

    try:
        return loop.run_until_complete(dash.run())
    except (KeyboardInterrupt, asyncio.CancelledError):
        dash.terminate_children()
        if dash.is_tty:
            sys.stdout.write(SHOW_CURSOR + "\n")
        print(f" {C_YELLOW}⚠ Refresh interrupted. Cleaned up background tasks.{RESET}")
        return 130
    finally:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)
            os.unlink(lock_path)
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main())
