    async def task_npm(self, t: TaskState) -> None:
        npm_path = shutil.which("npm") or ""
        real_npm = os.path.realpath(npm_path) if npm_path else ""

        t.step_label = "Scanning global packages"
        proc = await asyncio.create_subprocess_exec(
            "npm", "list", "-g", "--depth=0", "--parseable",
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        out, _ = await proc.communicate()
        lines = out.decode("utf-8", errors="replace").splitlines()[1:]
        pkgs = []
        for p in lines:
            if "/node_modules/" in p:
                pkg = p.split("/node_modules/")[-1].strip()
                if pkg and pkg not in ("npm", "openclaw"):
                    pkgs.append(pkg)

        t.progress = 0.25
        t.step_label = "Waiting for npm lock"
        async with self.npm_lock:
            if "Cellar/node" not in real_npm and "homebrew" not in real_npm:
                rc = await self.run_cmd(t, ["npm", "install", "-g", "npm"], "npm self-update", 0.25, 0.35, 3.0)
                if rc != 0:
                    raise RuntimeError("npm self-update failed")
            else:
                t.progress = 0.50

            if pkgs:
                rc = await self.run_cmd(
                    t,
                    ["npm", "update", "-g", *pkgs],
                    f"Updating {', '.join(pkgs)}",
                    0.50,
                    0.50,
                    4.0,
                )
                if rc != 0:
                    raise RuntimeError("npm update -g failed")
                t.last_line = f"Updated {', '.join(pkgs)}"
            else:
                t.progress = 1.0
                t.last_line = "No extra global packages to update"

    async def task_pip(self, t: TaskState) -> None:
        py_path = shutil.which("python3") or ""
        real_py = os.path.realpath(py_path) if py_path else ""
        if py_path == "/usr/bin/python3" or real_py.startswith("/Library/Developer/") or real_py.startswith("/System/"):
            await asyncio.sleep(0.15)
            t.progress = 1.0
            t.last_line = "System Python (managed via uv)"
            return

        check_code = (
            "import sysconfig, os\n"
            "for s in ('stdlib','platstdlib','purelib','platlib'):\n"
            "  p = sysconfig.get_path(s)\n"
            "  if p and os.path.exists(os.path.join(p, 'EXTERNALLY-MANAGED')): raise SystemExit(0)\n"
            "raise SystemExit(1)\n"
        )
        proc = await asyncio.create_subprocess_exec(
            "python3", "-c", check_code,
            stdout=asyncio.subprocess.DEVNULL,
            stderr=asyncio.subprocess.DEVNULL,
        )
        await proc.wait()
        if proc.returncode == 0:
            t.progress = 1.0
            t.last_line = "PEP 668 externally managed (skipped)"
            return

        rc = await self.run_cmd(t, ["python3", "-m", "pip", "install", "--upgrade", "pip"], "pip upgrade", 0.0, 1.0, 2.5)
        if rc != 0:
            raise RuntimeError("pip upgrade failed")

